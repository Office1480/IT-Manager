# Base de données PostgreSQL locale (voir docker-compose.yml)
DATABASE_URL="postgresql://itmanager:itmanager@localhost:5432/itmanager?schema=public"
# Secret de session (openssl rand -base64 32)
AUTH_SECRET="change-me-with-a-long-random-string-of-32-chars-min"
# Clé de chiffrement des fichiers et champs sensibles : 32 octets en base64 (openssl rand -base64 32)
ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTES"
# Dossier de stockage des documents chiffrés
STORAGE_DIR="./storage"
